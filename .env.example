# gopowerwall proxy - example environment file
#
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is loaded automatically by both the proxy (cmd/proxy) and the
# gopowerwall CLI (cmd/gopowerwall) before configuration is read. Real
# environment variables (e.g. docker-compose's `environment:`) always take
# precedence over values in .env, so the same image works unmodified in a
# docker-compose stack (real env vars) and on a laptop (.env file). A missing
# .env file is not an error.
#
# Never commit a real .env file - only this .env.example with placeholders.

# -----------------------------------------------------------------------------
# Tesla Cloud mode (PW_AUTH_MODE / connection via backend/cloud)
# -----------------------------------------------------------------------------
# Cloud mode authenticates to Tesla's Owner API with an OAuth2 refresh token
# rather than local gateway credentials. Tesla access tokens expire after a
# few hours; gopowerwall refreshes them automatically and persists the new
# token back to the auth file (PW_AUTH_PATH/.pypowerwall.auth), so a
# container restart never needs a freshly minted token.
#
# To obtain a refresh token:
#
#   1. Download tesla_auth from https://github.com/adriankumpf/tesla_auth
#      and run it (it opens a native login window for your Tesla account).
#   2. On the final screen, copy the "refresh token" (and, optionally, the
#      "access token") it displays.
#   3. Paste the refresh token below as TESLA_REFRESH_TOKEN.
#   4. Start the container. On first run, with no .pypowerwall.auth file
#      present yet, gopowerwall bootstraps one from these two variables and
#      immediately exchanges the refresh token for a fresh access token.
#
# After the first successful run, the refresh token (and any rotated access
# token) live in .pypowerwall.auth under PW_AUTH_PATH; TESLA_REFRESH_TOKEN is
# only consulted when that file does not exist yet.

# Refresh token from tesla_auth. Required to bootstrap cloud mode from .env.
TESLA_REFRESH_TOKEN=your-tesla-refresh-token

# Access token from tesla_auth (optional). If omitted, gopowerwall performs
# an immediate token refresh on first connect to obtain one.
TESLA_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Core Powerwall / Tesla account settings
# -----------------------------------------------------------------------------

# Tesla account email. Used to look up the right entry in .pypowerwall.auth
# for cloud mode, and to select a login when the auth file has more than one.
PW_EMAIL=you@example.com

# Powerwall Gateway hostname or IP (local/tedapi modes only). Leave unset for
# cloud or fleetapi mode.
PW_HOST=

# Local Powerwall Gateway "Customer" password (local/tedapi modes only).
PW_PASSWORD=

# TEDAPI Gateway password, printed on a label inside the Powerwall (tedapi
# mode only).
PW_GW_PWD=

# Wi-Fi AP hostname/IP for scanning (optional).
PW_WIFI_HOST=

# Site timezone, passed through to API responses as a plain string.
PW_TIMEZONE=America/Los_Angeles

# Tesla energy site id. Leave unset to auto-detect the first (or only) site
# on the account.
PW_SITEID=

# Directory holding .pypowerwall.auth, .pypowerwall.fleetapi and
# .pypowerwall.site. Leave unset to use the current working directory.
PW_AUTH_PATH=

# Authentication mode for the local Gateway API: cookie, token, basic, or
# bearer (local/tedapi modes only).
PW_AUTH_MODE=cookie

# -----------------------------------------------------------------------------
# Proxy HTTP server
# -----------------------------------------------------------------------------

# Address the proxy listens on. Empty means all interfaces.
PW_BIND_ADDRESS=

# Port the proxy listens on.
PW_PORT=8675

# Serve HTTPS using localhost.crt/localhost.key instead of plain HTTP: yes/no.
PW_HTTPS=no

# UI style bundle served by the proxy's dashboard (clear, dakboard, etc.).
PW_STYLE=clear

# Base URL prefix the proxy is mounted under behind a reverse proxy.
PROXY_BASE_URL=/

# Shared secret required to call the /control/* write endpoints. Leave unset
# to disable those endpoints.
PW_CONTROL_SECRET=

# Enable verbose debug logging: yes/no.
PW_DEBUG=no

# -----------------------------------------------------------------------------
# Caching and timeouts
# -----------------------------------------------------------------------------

# How long (seconds) responses are cached before the proxy refreshes them
# from the backend.
PW_CACHE_EXPIRE=5

# How long (seconds) a cached response may be served, in addition to
# PW_CACHE_EXPIRE, before it is considered stale.
PW_CACHE_TTL=30

# HTTP client timeout (seconds) for calls to the Gateway or Tesla APIs.
PW_TIMEOUT=5

# Browser cache-control max-age (seconds) sent to HTTP clients for static
# content. 0 disables browser caching.
PW_BROWSER_CACHE=0

# Path to the on-disk local Gateway session cache file.
PW_CACHE_FILE=.powerwall

# Maximum size of the backend HTTP connection pool.
PW_POOL_MAXSIZE=15

# -----------------------------------------------------------------------------
# TEDAPI (local protobuf transport)
# -----------------------------------------------------------------------------

# Path to the RSA private key used for v1r LAN TEDAPI registration.
PW_RSA_KEY_PATH=

# TEDAPI protocol version.
PW_TEDAPI_API_VERSION=V2024_06

# TEDAPI authentication mode.
PW_TEDAPI_AUTH_MODE=basic

# Enable automatic TEDAPI recovery after a probe failure: yes/no.
PW_TEDAPI_RECOVERY=yes

# Seconds between TEDAPI health probes (minimum 5; below that the default is
# used instead).
PW_TEDAPI_PROBE_INTERVAL=30

# Seconds between firmware-version checks (minimum 30; below that the
# default is used instead).
PW_FIRMWARE_CHECK_INTERVAL=300

# -----------------------------------------------------------------------------
# Metrics behavior and error handling
# -----------------------------------------------------------------------------

# Report solar power below zero as zero instead of the raw negative reading:
# yes/no.
PW_NEG_SOLAR=yes

# Snap site power readings within +/- this many watts of zero to exactly
# zero. 0 disables the correction.
PW_SITE_ZERO_THRESHOLD=0

# Return the last-known-good cached response instead of an error when a
# backend call fails: yes/no.
PW_GRACEFUL_DEGRADATION=yes

# Fail fast on backend errors instead of retrying: yes/no.
PW_FAIL_FAST=no

# Suppress logging of individual network errors (still counted in /stats):
# yes/no.
PW_SUPPRESS_NETWORK_ERRORS=no

# Maximum network errors logged per interval before suppression kicks in.
PW_NETWORK_ERROR_RATE_LIMIT=5

# Expose the /health endpoint: yes/no.
PW_HEALTH_CHECK=yes
